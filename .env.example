# =============================================================================
# Internal HRMS — environment template (internal distribution, no app stores)
# =============================================================================
# 1. cp .env.example .env      (.env is git-ignored — never commit or share it)
# 2. Fill the values below.
# 3. dart run tool/gen_app_config.dart
#      -> writes build/app_config.json with ONLY the public values the app
#         needs (Supabase URL + anon key, org code, environment, Firebase ids).
#         Nothing else from this file is ever compiled into the app.
#
# Use a dedicated staging Supabase project for testing; test scripts create and
# reset synthetic data. Quote values that contain spaces.
# =============================================================================


# --- Supabase ----------------------------------------------------------------

# Dashboard -> Project Settings -> General -> Project ID
SUPABASE_PROJECT_REF=

# supabase.com/dashboard/account/tokens — used by the CLI for migrations,
# Edge Function deploys and secrets. Has full account access: keep private.
SUPABASE_ACCESS_TOKEN=

# Dashboard -> Connect -> "Session pooler" URI (port 5432) with DB password.
SUPABASE_DB_URL=

# Dashboard -> Project Settings -> API Keys -> Secret key (sb_secret_...).
# Used only by local seed/test scripts; never compiled into the app.
SUPABASE_SERVICE_ROLE_KEY=

# Dashboard -> Project Settings -> API. The app's public connection values.
# Anon/publishable key ONLY — never the service_role / secret key.
APP_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
APP_SUPABASE_ANON_KEY=


# --- Organisation & first Admin (used once by tool/bootstrap_admin.dart) -----
# The Admin's temporary password is generated and shown once; it must be
# changed at first login.

HRMS_ORG_CODE=MAIN
HRMS_ORG_NAME="Internal HRMS"
HRMS_ORG_TIMEZONE=Asia/Kolkata
HRMS_BOOTSTRAP_ADMIN_CODE=ADMIN001
HRMS_BOOTSTRAP_ADMIN_NAME="Administrator"


# --- Server behaviour --------------------------------------------------------

# staging | production.
#   staging    -> also accepts emulator/software device keys for punch testing
#   production -> only hardware-attested device keys from the signed app
HRMS_ENVIRONMENT=staging

# Shared secret between the database scheduler (stored in Supabase Vault) and
# the maintenance function. Generate: openssl rand -hex 32
HRMS_MAINTENANCE_SECRET=


# --- Optional: push notifications (Android) ----------------------------------
# Leave blank to run without push; the in-app notification inbox still works.
# Firebase console -> Project settings -> General -> Android app.
APP_FIREBASE_PROJECT_ID=
APP_FIREBASE_MESSAGING_SENDER_ID=
APP_FIREBASE_ANDROID_API_KEY=
APP_FIREBASE_ANDROID_APP_ID=
# Firebase console -> Project settings -> Service accounts -> Generate new
# private key, then:  base64 -w0 key.json
HRMS_FCM_SERVICE_ACCOUNT_B64=


# --- Optional until you build the release APK --------------------------------
# One keystore signs every release; keep it backed up — app updates must be
# signed with the same key. Create: keytool -genkeypair -v -keystore hrms.jks
#   -keyalg RSA -keysize 4096 -validity 10000 -alias hrms
ANDROID_KEYSTORE_PATH=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=
